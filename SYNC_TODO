#### 3.2 Sync Service (Django)

**`sync/services/sync.py`**

```python
# sync/services/sync.py
import logging
from django.db import transaction
from django.utils import timezone
from django.core.exceptions import ValidationError

from borrowers.models.borrower import Borrower
from debts.models.debt import Debt
from payments.models.payment_transaction import PaymentTransaction
from payments.models.penalty_transaction import PenaltyTransaction

logger = logging.getLogger(__name__)

# Entity mapping
ENTITY_MAP = {
    'borrowers': {
        'model': Borrower,
        'id_field': 'id',
        'fields': ['name', 'contact', 'email', 'address', 'notes', 'deleted_at', 'created_at', 'updated_at'],
    },
    'debts': {
        'model': Debt,
        'id_field': 'id',
        'fields': ['name', 'total_amount', 'paid_amount', 'remaining_amount', 'due_date', 'status', 'interest_rate', 'penalty_rate', 'borrower_id', 'deleted_at', 'created_at', 'updated_at'],
    },
    'payment_transactions': {
        'model': PaymentTransaction,
        'id_field': 'id',
        'fields': ['amount', 'payment_date', 'reference', 'notes', 'method_id', 'debt_id', 'deleted_at', 'recorded_at'],
    },
    'penalty_transactions': {
        'model': PenaltyTransaction,
        'id_field': 'id',
        'fields': ['amount', 'penalty_date', 'reason', 'debt_id', 'deleted_at', 'created_at'],
    },
}


class SyncService:
    """
    Service for processing sync data from offline clients.
    """

    @staticmethod
    def process_sync(entity_name, records, user=None, request=None):
        """
        Process sync records for a specific entity.
        
        Args:
            entity_name: Name of the entity (e.g., 'borrowers')
            records: List of records to sync
            user: User performing the sync
            request: HTTP request object for audit
        """
        entity_config = ENTITY_MAP.get(entity_name)
        if not entity_config:
            raise ValueError(f"Unknown entity: {entity_name}")

        model = entity_config['model']
        id_field = entity_config['id_field']
        fields = entity_config['fields']

        results = {
            'created': 0,
            'updated': 0,
            'skipped': 0,
            'errors': [],
            'ids': [],
        }

        for record in records:
            try:
                record_id = record.get(id_field)
                
                if not record_id:
                    # Create new record (client didn't specify ID)
                    instance = SyncService._create_record(model, record, fields, user, request)
                    results['created'] += 1
                    results['ids'].append(instance.pk)
                    continue

                # Check if record exists
                existing = model.objects.filter(id=record_id).first()
                
                if existing:
                    # Update existing record
                    # Check if client record is newer
                    client_updated = record.get('updated_at')
                    if client_updated:
                        client_time = timezone.datetime.fromisoformat(client_updated.replace('Z', '+00:00'))
                        if existing.updated_at and existing.updated_at >= client_time:
                            results['skipped'] += 1
                            continue
                    
                    SyncService._update_record(existing, record, fields, user, request)
                    results['updated'] += 1
                    results['ids'].append(existing.pk)
                else:
                    # Client has ID but server doesn't - create it
                    instance = SyncService._create_record(
                        model, record, fields, user, request, force_id=record_id
                    )
                    results['created'] += 1
                    results['ids'].append(instance.pk)

            except Exception as e:
                logger.error(f"Failed to sync record {record.get(id_field)}: {e}")
                results['errors'].append({
                    'record': record,
                    'error': str(e),
                })

        return results

    @staticmethod
    @transaction.atomic
    def _create_record(model, data, fields, user=None, request=None, force_id=None):
        """Create a new record from sync data."""
        clean_data = {k: v for k, v in data.items() if k in fields}
        
        # Remove fields that should not be set directly
        clean_data.pop('id', None)
        
        if force_id:
            # For clients that have a specific ID, we need to set it
            clean_data['id'] = force_id
            instance = model(**clean_data)
        else:
            instance = model(**clean_data)
        
        instance.full_clean()
        instance.save()
        
        # Audit log (optional)
        if user and request:
            from audit.utils.log import log_audit_event
            log_audit_event(
                request=request,
                user=user,
                action_type='sync_create',
                model_name=model.__name__,
                object_id=str(instance.pk),
                changes={'sync': True},
            )
        
        return instance

    @staticmethod
    def _update_record(instance, data, fields, user=None, request=None):
        """Update an existing record from sync data."""
        clean_data = {k: v for k, v in data.items() if k in fields}
        
        # Remove fields that should not be updated
        clean_data.pop('id', None)
        clean_data.pop('created_at', None)
        
        for key, value in clean_data.items():
            setattr(instance, key, value)
        
        instance.full_clean()
        instance.save()
        
        # Audit log
        if user and request:
            from audit.utils.log import log_audit_event
            log_audit_event(
                request=request,
                user=user,
                action_type='sync_update',
                model_name=instance.__class__.__name__,
                object_id=str(instance.pk),
                changes={'sync': True, 'data': clean_data},
            )
        
        return instance

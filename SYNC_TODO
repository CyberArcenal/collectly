// src/main/services/SyncService.js
const { AppDataSource } = require("../main/db/data-source");
const onlineClient = require("../utils/onlineClient");
const { serverUrl, syncMode } = require("../utils/system");
const { logger } = require("../utils/logger");

class SyncService {
  constructor() {
    this.syncStatus = {
      isSyncing: false,
      lastSync: null,
      pendingChanges: 0,
      entities: {},
    };
    this.entities = [
      { name: 'Borrower', table: 'borrowers', fields: ['id', 'name', 'contact', 'email', 'address', 'notes', 'deletedAt', 'createdAt', 'updatedAt'] },
      { name: 'Debt', table: 'debts', fields: ['id', 'name', 'totalAmount', 'paidAmount', 'remainingAmount', 'dueDate', 'status', 'interestRate', 'penaltyRate', 'borrowerId', 'deletedAt', 'createdAt', 'updatedAt'] },
      { name: 'PaymentTransaction', table: 'payment_transactions', fields: ['id', 'amount', 'paymentDate', 'reference', 'notes', 'methodId', 'debtId', 'deletedAt', 'recordedAt'] },
      { name: 'PenaltyTransaction', table: 'penalty_transactions', fields: ['id', 'amount', 'penaltyDate', 'reason', 'debtId', 'deletedAt', 'createdAt'] },
      { name: 'LoanAgreement', table: 'loan_agreements', fields: ['id', 'status', 'agreementDate', 'lenderName', 'termsText', 'filePath', 'debtId', 'deletedAt', 'signedAt', 'signedBy', 'principalAmount', 'interestRate', 'penaltyRate', 'dueDate', 'purpose', 'loanStartDate', 'anniversaryDay'] },
      { name: 'LoanApplication', table: 'loan_applications', fields: ['id', 'debtorId', 'debtorName', 'debtorContact', 'debtorEmail', 'debtorAddress', 'requestedAmount', 'purpose', 'proposedDueDate', 'interestRate', 'status', 'approvedAt', 'rejectedAt', 'approvedBy', 'rejectionReason', 'deletedAt', 'createdAt', 'updatedAt'] },
      { name: 'PaymentMethod', table: 'payment_methods', fields: ['id', 'name', 'description', 'icon', 'isDefault', 'createdAt', 'updatedAt'] },
    ];
  }

  /**
   * Get last sync timestamp for an entity
   */
  async getLastSyncTime(entityName) {
    const repo = AppDataSource.getRepository('SyncMetadata');
    const record = await repo.findOne({ where: { entity: entityName } });
    return record ? record.lastSyncedAt : null;
  }

  /**
   * Update last sync timestamp for an entity
   */
  async updateLastSyncTime(entityName, timestamp) {
    const repo = AppDataSource.getRepository('SyncMetadata');
    let record = await repo.findOne({ where: { entity: entityName } });
    if (!record) {
      record = repo.create({ entity: entityName, lastSyncedAt: timestamp });
    } else {
      record.lastSyncedAt = timestamp;
    }
    await repo.save(record);
  }

  /**
   * Get entities that changed since last sync
   */
  async getChangedEntities(entityName, since) {
    const repo = AppDataSource.getRepository(entityName);
    const qb = repo.createQueryBuilder(entityName)
      .where(`${entityName}.updatedAt >= :since`, { since })
      .orWhere(`${entityName}.createdAt >= :since`, { since });
    
    // For soft-deleted entities
    if (repo.hasColumn('deletedAt')) {
      qb.orWhere(`${entityName}.deletedAt >= :since`, { since });
    }
    
    return await qb.getMany();
  }

  /**
   * Perform full sync (all entities)
   */
  async fullSync(user) {
    this.syncStatus.isSyncing = true;
    this.syncStatus.pendingChanges = 0;
    
    const results = {
      success: 0,
      failed: 0,
      errors: [],
      changes: {},
    };

    try {
      const url = await serverUrl();
      if (!url) throw new Error('Server URL not configured');
      onlineClient.setBaseUrl(url);

      for (const entity of this.entities) {
        try {
          const result = await this.syncEntity(entity, user);
          results.changes[entity.name] = result;
          if (result.success) {
            results.success += result.count || 0;
          } else {
            results.failed += result.count || 0;
            if (result.error) results.errors.push(result.error);
          }
        } catch (err) {
          results.failed++;
          results.errors.push({ entity: entity.name, error: err.message });
          logger.error(`Sync failed for ${entity.name}:`, err);
        }
      }

      this.syncStatus.lastSync = new Date();
      this.syncStatus.isSyncing = false;
      
      return results;
    } catch (error) {
      this.syncStatus.isSyncing = false;
      throw error;
    }
  }

  /**
   * Sync a single entity
   */
  async syncEntity(entity, user) {
    const since = await this.getLastSyncTime(entity.name);
    const changed = await this.getChangedEntities(entity.name, since);
    const now = new Date();

    if (changed.length === 0) {
      return { success: true, count: 0, message: 'No changes' };
    }

    const url = await serverUrl();
    if (!url) throw new Error('Server URL not configured');
    onlineClient.setBaseUrl(url);

    // ✅ Send all changed records to server
    const endpoint = `/api/v1/sync/${entity.name.toLowerCase()}s/`;
    const response = await onlineClient.post(endpoint, {
      data: changed,
      user: user || 'system',
    });

    if (!response.ok) {
      const errorText = await response.text();
      throw new Error(`Server sync failed: ${response.status} - ${errorText}`);
    }

    // ✅ Update sync timestamp
    await this.updateLastSyncTime(entity.name, now);

    return { 
      success: true, 
      count: changed.length, 
      message: `Synced ${changed.length} ${entity.name}(s)` 
    };
  }
}

module.exports = new SyncService();
```


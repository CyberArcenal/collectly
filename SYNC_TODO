### 📋 Phase 6: Cron / Automated Sync

**`src/main/scheduler/autoSyncScheduler.js`**

```javascript
// src/main/scheduler/autoSyncScheduler.js
const { logger } = require("../utils/logger");
const syncService = require("../services/SyncService");
const { syncMode } = require("../utils/system");

class AutoSyncScheduler {
  constructor() {
    this.interval = null;
    this.isRunning = false;
  }

  async start(intervalMinutes = 30) {
    if (this.interval) return;
    
    // Only run if in online or offline_first mode
    const mode = await syncMode();
    if (mode === "offline") return;

    this.interval = setInterval(async () => {
      await this.runSync();
    }, intervalMinutes * 60 * 1000);

    logger.info(`Auto-sync started (every ${intervalMinutes} minutes)`);
  }

  async runSync() {
    if (this.isRunning) return;
    
    this.isRunning = true;
    try {
      const mode = await syncMode();
      if (mode === "offline") return;
      
      const result = await syncService.fullSync('system');
      logger.info(`Auto-sync completed: ${JSON.stringify(result)}`);
    } catch (error) {
      logger.error("Auto-sync failed:", error);
    } finally {
      this.isRunning = false;
    }
  }

  stop() {
    if (this.interval) {
      clearInterval(this.interval);
      this.interval = null;
      logger.info("Auto-sync stopped");
    }
  }
}

module.exports = new AutoSyncScheduler();
```


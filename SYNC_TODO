// src/main/ipc/utils/sync/index.ipc.js
const { ipcMain } = require("electron");
const { withErrorHandling } = require("../../../../middlewares/errorHandler");
const syncService = require("../../../../services/SyncService");
const { logger } = require("../../../../utils/logger");

class SyncHandler {
  constructor() {
    this.initializeHandlers();
  }

  initializeHandlers() {
    this.fullSync = this.importHandler("./full_sync.ipc");
    this.syncStatus = this.importHandler("./status.ipc");
    this.syncEntity = this.importHandler("./entity.ipc");
  }

  importHandler(path) {
    try {
      const fullPath = require.resolve(`./${path}`, { paths: [__dirname] });
      return require(fullPath);
    } catch (error) {
      return async () => ({ status: false, message: `Handler not implemented: ${path}` });
    }
  }

  async handleRequest(event, payload) {
    const { method, params = {} } = payload;

    switch (method) {
      case "fullSync":
        return await this.fullSync(params);
      case "syncStatus":
        return await this.syncStatus(params);
      case "syncEntity":
        return await this.syncEntity(params);
      default:
        return { status: false, message: `Unknown sync method: ${method}` };
    }
  }
}

const syncHandler = new SyncHandler();
ipcMain.handle("sync", withErrorHandling(syncHandler.handleRequest.bind(syncHandler), "IPC:sync"));

module.exports = { SyncHandler, syncHandler };
